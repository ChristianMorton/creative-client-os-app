# Local Postgres from docker compose (see README).
DATABASE_URL=postgres://creative:creative@127.0.0.1:5432/creative_client_os

# Required by Auth.js. The value below is for local dev only.
AUTH_SECRET=local-dev-secret-not-for-production-use-32b
AUTH_URL=http://127.0.0.1:43123

# Google OAuth. Leave blank to use the dev studio sign-in.
# Scopes requested: openid email profile, calendar.events, drive.file
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development only: also show sample studio sign-in alongside Google.
# Production always disables sample studio sign-in, even without Google credentials.
AUTH_DEV_MODE=true

# Dropbox. Leave these empty to keep Dropbox unconfigured (no HTTP, no folder rows).
# Either set DROPBOX_ACCESS_TOKEN on its own, or set the app key, secret, and refresh token together.
# Scopes: files.metadata.read, files.metadata.write. Use token_access_type=offline for the refresh token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=
